<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.5.0</Version>
    <Product>VolumeBridge</Product>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VolumeBridge</AssemblyName>
    <RootNamespace>VolumeBridge</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>embedded</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!-- Embed VolumeBridgeApo.dll when provided (CI passes -p:ApoDll=... -p:RequireApo=true). -->
  <ItemGroup Condition="'$(ApoDll)' != '' and Exists('$(ApoDll)')">
    <EmbeddedResource Include="$(ApoDll)" LogicalName="VolumeBridgeApo.dll" />
  </ItemGroup>

  <Target Name="CheckRequiredApo" BeforeTargets="BeforeBuild" Condition="'$(RequireApo)' == 'true'">
    <Error Condition="'$(ApoDll)' == '' or !Exists('$(ApoDll)')"
           Text="RequireApo=true but ApoDll ('$(ApoDll)') was not found." />
  </Target>

  <!-- Embed NAudio runtime DLLs into VolumeBridge.exe so the build output is a single portable exe. -->
  <Target Name="EmbedNuGetDlls" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_EmbedDlls Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <EmbeddedResource Include="@(_EmbedDlls)" LogicalName="%(Filename)%(Extension)" />
      <ReferenceCopyLocalPaths Remove="@(_EmbedDlls)" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.xml' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
